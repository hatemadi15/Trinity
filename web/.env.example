# Copy to .env.local (gitignored). The key stays on the server: /api/chat reads it, the browser never sees it.
OPENROUTER_API_KEY=
# Free-tier chain, first answer wins; each model gets 10 s inside a 24 s budget. Order from the live probes of 2026-09-29.
OPENROUTER_MODELS=qwen/qwen3.8-27b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free
AI_MODEL_TIMEOUT_MS=10000
# live: ask the model when a key is set; cached: rehearsed transcripts only (same as ?demo=1 in the URL).
NEXT_PUBLIC_AI_MODE=live
# /api/chat requests per minute per client address (per server instance).
AI_RATE_LIMIT_PER_MIN=30
# Where the browser fetches the data files (ephemeris, masks, tiles, terrain). Local: /data (web/public/data from sync-local). No trailing slash; empty means /data.
NEXT_PUBLIC_DATA_BASE=/data
# The address the site is opened at; the share image's link is built on it. Set it on a preview or a custom domain; empty means https://earthrise.vercel.app.
NEXT_PUBLIC_SITE_URL=
