# Copy to .env.local (gitignored). The key stays on the server: /api/chat reads it, the browser never sees it.
OPENROUTER_API_KEY=
# Free-tier chain, first answer wins; each model gets 10 s.
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3.8-27b:free,nvidia/nemotron-3.5-lightning:free
# live: ask the model when a key is set; cached: rehearsed transcripts only (same as ?demo=1 in the URL).
NEXT_PUBLIC_AI_MODE=live
# /api/chat requests per minute per client address (per server instance).
AI_RATE_LIMIT_PER_MIN=30
# Where the browser fetches the data files (ephemeris, masks, tiles, terrain). Local: /data (web/public/data from sync-local).
NEXT_PUBLIC_DATA_BASE=/data
