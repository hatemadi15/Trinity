# Copy to .env.local (gitignored), in web/: Copy-Item .env.example .env.local (PowerShell), copy .env.example .env.local (Command Prompt), cp .env.example .env.local (macOS, Linux).
# Every variable has a default, so the app runs without the file. npm run dev and npm start read it when they start; a variable set in the terminal wins over it.
# The key stays on the server: /api/chat reads it, the browser never sees it. Empty: no model is asked; the assistant answers the phrasings it knows (phrase matcher, rehearsed answers) and the brief's paragraph comes from its template.
OPENROUTER_API_KEY=
# Free-tier chain, first answer wins; each model gets 10 s inside a 24 s budget. Order from the live probes of 2026-09-29. Empty means the same four (src/lib/ai/openrouter.ts).
OPENROUTER_MODELS=qwen/qwen3.8-27b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free
# Google's Gemini, for Luna (spec 22.5): her replies in Gemini's voice (/api/speak), her listening in browsers without speech
# recognition such as Firefox (/api/transcribe), and the assistant's last fallback (text goes to OpenRouter first, for everyone).
# Server only, never a NEXT_PUBLIC_ variable. Empty: those routes answer 503 at once and Luna uses the browser's voice and typed words.
GEMINI_API_KEY=
# The models and the voice; empty means these defaults (src/lib/ai/gemini.ts). Google renames its models, so they may need updating to the current names.
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# One of Gemini's prebuilt voices (Leda, Aoede, Zephyr, Kore, ...).
GEMINI_VOICE=Leda
# How long one model in the chain may take, in milliseconds, before the next one is asked (also Gemini's limit in Luna's voice routes).
AI_MODEL_TIMEOUT_MS=10000
# Total model time per request across the chain (read at src/app/api/chat/route.ts, see docs/hosting.md).
AI_MODEL_BUDGET_MS=24000
# live: ask the model when a key is set; cached: rehearsed transcripts only and never Gemini (same as ?demo=1 in the URL). Built into the pages by npm run build, so set it before building.
NEXT_PUBLIC_AI_MODE=live
# Requests per minute per client address (per server instance), for /api/chat and for each of Luna's voice routes.
AI_RATE_LIMIT_PER_MIN=30
# Where the browser fetches the data files (ephemeris, masks, tiles, terrain). Local: /data (web/public/data from sync-local). No trailing slash; empty means /data. Built in at build time.
NEXT_PUBLIC_DATA_BASE=/data
# The address the site is opened at; the share image's link is built on it. Set it on a preview or a custom domain; empty means https://earthrise.vercel.app. Built in at build time.
NEXT_PUBLIC_SITE_URL=
